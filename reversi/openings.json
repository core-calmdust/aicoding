순위로 점수가 매겨집니다(최대 14점).","hint":"금색 원이 이 국면에서 이어지는 정석 수입니다."}},"lines":[{"name":{"ja":"闘牛","en":"Bullfight (Heath)","zh":"斗牛","ko":"투우"},"moves":"f5f6e6f4g5"},{"name":{"ja":"裏こうもり","en":"Ura-Komori (Reverse Bat)","zh":"反蝙蝠","ko":"역박쥐"},"moves":"f5f6e6f4g5e7e3"},{"name":{"ja":"野いちご","en":"Noichigo (Wild Strawberry)","zh":"野草莓","ko":"산딸기"},"moves":"f5f6e6f4g5e7f7d6"},{"name":{"ja":"飛び出し村上流","en":"Murakami's Jump","zh":"村上飞出流","ko":"무라카미류 튀어나오기"},"moves":"f5f6e6f4g5e7f7h5"},{"name":{"ja":"鼠","en":"Mouse","zh":"鼠","ko":"쥐"},"moves":"f5f4e3f6d3"}],"problems":[{"line":0,"k":2,"cells":"0000000000000000000000000002100000012100000002000000000000000000","toMove":1,"moves":"f5f6","ans":44,"book":[44],"type":"eval","f":{"19":[-6.5],"26":[-6.1],"44":[2.3],"53":[-11.3]}},{"line":0,"k":3,"cells":"0000000000000000000000000002100000011100000012000000000000000000","toMove":2,"moves":"f5f6e6","ans":29,"book":[29],"type":"eval","f":{"29":[-2.3],"43":[-2.3]}},{"line":0,"k":4,"cells":"0000000000000000000000000002220000011200000012000000000000000000","toMove":1,"moves":"f5f6e6f4","ans":38,"book":[20,18,46,38],"type":"eval","f":{"18":[0.8],"19":[-2.1],"20":[3.9],"21":[0.2],"22":[-2.1],"30":[-1.6],"38":[4.5],"46":[2.3],"54":[-18.6]}},{"line":1,"k":2,"cells":"0000000000000000000000000002100000012100000002000000000000000000","toMove":1,"moves":"f5f6","ans":44,"book":[44],"type":"eval","f":{"19":[-6.5],"26":[-6.1],"44":[2.3],"53":[-11.3]}},{"line":1,"k":3,"cells":"0000000000000000000000000002100000011100000012000000000000000000","toMove":2,"moves":"f5f6e6","ans":29,"book":[29],"type":"eval","f":{"29":[-2.3],"43":[-2.3]}},{"line":1,"k":4,"cells":"0000000000000000000000000002220000011200000012000000000000000000","toMove":1,"moves":"f5f6e6f4","ans":38,"book":[20,18,46,38],"type":"eval","f":{"18":[0.8],"19":[-2.1],"20":[3.9],"21":[0.2],"22":[-2.1],"30":[-1.6],"38":[4.5],"46":[2.3],"54":[-18.6]}},{"line":1,"k":5,"cells":"0000000000000000000000000002220000011110000012000000000000000000","toMove":2,"m