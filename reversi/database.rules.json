{
  "rules": {
    "players": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'rating']) && newData.child('rating').isNumber() && newData.child('name').isString() && newData.child('name').val().length <= 16"
      }
    },
    "lobby": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || (data.exists() && newData.exists() && !data.child('game').exists() && newData.child('name').val() === data.child('name').val() && newData.child('rating').val() === data.child('rating').val()))"
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || (!data.child('game').exists() && newData.child('host').val() === data.child('host').val()))"
      }
    },
    "games": {
      "$gid": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && (newData.child('b').val() === auth.uid || newData.child('w').val() === auth.uid)) || data.child('b').val() === auth.uid || data.child('w').val() === auth.uid)"
      }
    },
    "chat": {
      ".read": "auth != null",
      "seq": {
        ".write": "auth != null",
        ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)"
      },
      "msgs": {
        "$slot": {
          ".write": "auth != null && newData.exists()",
          ".validate": "$slot.matches(/^(1[0-9]|[0-9])$/) && newData.hasChildren(['n', 'uid', 'name', 'text', 't']) && newData.child('uid').val() === auth.uid",
          "n": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "uid": { ".validate": "newData.isString()" },
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
          "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
          "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "$other": { ".validate": false }
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}