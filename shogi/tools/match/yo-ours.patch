+#elif MATERIAL_LEVEL == 100
+	// The CALMDUST site's shogi net (shogi/nnue.bin.gz unpacked, "NUEQ": 2534 piece-only inputs -> H x 2 -> 1, SCReLU),
+	// computed from scratch at every call: slow, for matches at equal nodes only (the same evaluation behind another search).
+	// OURNET = the net file; OURSCALE = percent applied to the value (default 100).
+	namespace {
+		int H_ = 0, scalePct = 100; std::vector<int16_t> W1_, W2_; std::vector<int32_t> B1_; int32_t B2_ = 0;
+		std::once_flag onceNet;
+		void loadNet() {
+			const char* path = getenv("OURNET"); const char* sc = getenv("OURSCALE"); if (sc) scalePct = atoi(sc);
+			FILE* f = path ? fopen(path, "rb") : nullptr; int32_t hd[3];
+			if (!f || fread(hd, 4, 3, f) != 3 || hd[0] != 0x5145554E || hd[2] != 2534) { sync_cout << "info string OURNET: cannot read a NUEQ net" << sync_endl; exit(1); }
+			H_ = hd[1]; W1_.resize((size_t)2534 * H_); B1_.resize(H_); W2_.resize(2 * H_);
+			if (fread(W1_.data(), 2, W1_.size(), f) != W1_.size() || fread(B1_.data(), 4, H_, f) != (size_t)H_ || fread(W2_.data(), 2, 2 * H_, f) != (size_t)(2 * H_) || fread(&B2_, 4, 1, f) != 1) { sync_cout << "info string OURNET: short file" << sync_endl; exit(1); }
+			fclose(f);
+		}
+	}
+	void add_options(OptionsMap&, ThreadPool&) {}
+	Value compute_eval(const Position& pos) {
+		std::call_once(onceNet, loadNet);
+		const int H = H_; int16_t acc[2][1024];
+		for (int c = 0; c < 2; c++) for (int j = 0; j < H; j++) acc[c][j] = (int16_t)B1_[j];
+		for (int y = 0; y < 81; y++) {
+			Piece pc = pos.piece_on((Square)y); if (pc == NO_PIECE) continue;
+			const int t = (int)type_of(pc), col = (int)color_of(pc), s = (y % 9) * 9 + (8 - y / 9);   // (rank) * 9 + (9 - file)
+			for (int c = 0; c < 2; c++) { const int16_t* w = &W1_[(size_t)(((col != c) * 14 + t - 1) * 81 + (c ? 80 - s : s)) * H]; int16_t* a = acc[c]; for (int j = 0; j < H; j++) a[j] += w[j]; }
+		}
+		static const PieceType HP[7] = { PAWN, LANCE, KNIGHT, SILVER, BISHOP, ROOK, GOLD };
+		for (int hc = 0; hc < 2; hc++) for (int t = 1; t <= 7; t++) {
+			const int n = hand_count(pos.hand_of((Color)hc), HP[t - 1]);
+			for (int k = 1; k <= n && k <= 19; k++) for (int c = 0; c < 2; c++) { const int16_t* w = &W1_[(size_t)(2268 + ((hc != c) * 7 + t - 1) * 19 + k - 1) * H]; int16_t* a = acc[c]; for (int j = 0; j < H; j++) a[j] += w[j]; }
+		}
+		const int us = (int)pos.side_to_move(); const int16_t *a = acc[us], *b = acc[us ^ 1]; long long sum = 0;
+		for (int i = 0; i < H; i++) { int x = a[i] < 0 ? 0 : a[i] > 127 ? 127 : a[i]; sum += (long long)x * x * W2_[i]; x = b[i] < 0 ? 0 : b[i] > 127 ? 127 : b[i]; sum += (long long)x * x * W2_[H + i]; }
+		const long long v = sum / 127 + B2_;
+		return (Value)(int)((double)v * 600 / (127 * 64) * scalePct / 100);
+	}
 #endif // MATERIAL_LEVEL
 
 } // namespace Eval
